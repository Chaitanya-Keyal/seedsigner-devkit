#!/usr/bin/env bash
#
# Set up a seedsigner-os -dev device for development, after ss-deploy has put a checkout
# on it. Safe to rerun; it only redoes what's missing, apart from refreshing the files.
#   - The app's venv, if there isn't one (needs the device online; about 3 minutes).
#   - device/sitecustomize.py into the venv's site-packages (HDMI mirror, keyboard,
#     service log).
#   - device/bashrc and bash_profile into /root (persistent on the -dev image).
#   - With --hdmi: /mnt/data/display-mirror set to "1 3" (HDMI mirror and keyboard as
#     buttons, actual size on tty3), if it doesn't exist. Without a monitor leave it out:
#     while the mirror is on, the device's own screen says "Showing on HDMI monitor".
#
#   ss-device-setup [--hdmi] [--no-restart]
#
# Set SEEDSIGNER_HOST to the device's ssh host (default: seedsigner-dev). Uses ssh
# and cat rather than scp, since the -dev image's dropbear has no sftp-server.

set -euo pipefail

HOST="${SEEDSIGNER_HOST:-seedsigner-dev}"
DEVICE_DIR="$(dirname "$(readlink -f "$0")")/../device"
RESTART=1
HDMI=0

for arg in "$@"; do
  case "$arg" in
    --no-restart) RESTART=0 ;;
    --hdmi) HDMI=1 ;;
    *) echo "Unknown option: $arg" >&2; exit 1 ;;
  esac
done

ssh "$HOST" "HDMI=$HDMI sh -s" <<'REMOTE'
set -e
cd /mnt/data/seedsigner
[ -f src/main.py ] || { echo "No checkout in /mnt/data/seedsigner: run ss-deploy first" >&2; exit 1; }
if [ ! -x venv/bin/python ]; then
  echo "Creating the app's venv"
  # The image's venv defaults include the system site-packages (Pillow, numpy, ...)
  python3 -m venv venv
  # Hash-locked, so these two share one install; -e . must be separate
  venv/bin/python -m pip install -q -r tests/requirements.txt -r l10n/requirements-l10n.txt
  venv/bin/python -m pip install -q -e .
  venv/bin/python setup.py -q compile_catalog >/dev/null 2>&1
fi
if [ "$HDMI" = 1 ] && [ ! -f /mnt/data/display-mirror ]; then
  echo "1 3" > /mnt/data/display-mirror
fi
REMOTE

SITE="$(ssh "$HOST" '/mnt/data/seedsigner/venv/bin/python -c "import sysconfig; print(sysconfig.get_path(\"purelib\"))"')"
echo "Installing to $HOST ($SITE)"
ssh "$HOST" "cat > '$SITE/sitecustomize.py'" < "$DEVICE_DIR/sitecustomize.py"
ssh "$HOST" "cat > /root/.bashrc" < "$DEVICE_DIR/bashrc"
ssh "$HOST" "cat > /root/.bash_profile" < "$DEVICE_DIR/bash_profile"

if [ "$RESTART" = 1 ]; then
  ssh "$HOST" seedsigner restart
fi
