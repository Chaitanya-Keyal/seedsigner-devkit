diff --git a/opt/pi02w-dev/board/boot_cmdline.txt b/opt/pi02w-dev/board/boot_cmdline.txt
index 8f486bb..f7918c6 100644
--- a/opt/pi02w-dev/board/boot_cmdline.txt
+++ b/opt/pi02w-dev/board/boot_cmdline.txt
@@ -1 +1 @@
-console=tty1 ipv6.disable=1
+console=tty2 ipv6.disable=1
diff --git a/opt/pi02w-dev/board/boot_config.txt b/opt/pi02w-dev/board/boot_config.txt
index 5423fd7..a1e8f7d 100644
--- a/opt/pi02w-dev/board/boot_config.txt
+++ b/opt/pi02w-dev/board/boot_config.txt
@@ -22,9 +22,21 @@ disable_splash=1
 # Wifi and bluetooth stay enabled (release adds disable-wifi/disable-bt here)
 
 # USB relay: expose the USB port as an ethernet gadget when plugged into a
-# computer (see docs/dev_images.md). dwc2 is built dual-role, so a keyboard
-# on an OTG adapter still works.
-dtoverlay=dwc2
+# computer (see docs/dev_images.md). Off: in host mode dwc2 fails on a keyboard
+# on an OTG adapter (error -71), so the default dwc_otg driver runs the port.
+#dtoverlay=dwc2
 
 # HDMI console output even when the display is plugged in after boot
 hdmi_force_hotplug=1
+
+# HDMI fixed at 1080p60 with full-range colour and no overscan border, so the console
+# and mirror look the same whether or not a monitor was in at boot (hdmi_force_hotplug
+# alone falls back to 640x480) and black shows as black on a PC monitor
+hdmi_group=1
+hdmi_mode=16
+hdmi_pixel_encoding=2
+disable_overscan=1
+
+# Full CPU speed (1 GHz): the kernel cpufreq driver fails to load on this board
+# (seedsigner-os#129), so without this the CPU stays at 600 MHz
+force_turbo=1
diff --git a/opt/pi02w-dev/board/kernel.config.fragment b/opt/pi02w-dev/board/kernel.config.fragment
index a025564..f694d41 100644
--- a/opt/pi02w-dev/board/kernel.config.fragment
+++ b/opt/pi02w-dev/board/kernel.config.fragment
@@ -64,3 +64,7 @@ CONFIG_AUXDISPLAY=y
 
 # Persistent ext4 data partition (/dev/mmcblk0p2)
 CONFIG_EXT4_FS=y
+
+# The BCM2835 watchdog driver is what restarts the board; without it reboot halts
+CONFIG_WATCHDOG=y
+CONFIG_BCM2835_WDT=y
